# Database (Neon PostgreSQL)
DATABASE_URL="postgres-redacted"
DIRECT_URL="postgres-redacted"

# Auth (NextAuth.js)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption
ENCRYPTION_MASTER_KEY="generate-64-char-hex-string"
ENCRYPTION_KEY_VERSION="v1"
# Optional — set ONLY during an ENCRYPTION_MASTER_KEY rotation. decrypt() falls
# back to this previous key so existing secrets keep decrypting; they migrate to
# the new key as they're read (re-encrypt-on-read). Remove once migration is
# complete. NEVER rotate ENCRYPTION_MASTER_KEY without setting this first.
ENCRYPTION_MASTER_KEY_PREVIOUS=""

# Dodo Payments
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DODO_PRODUCT_TEMPLATE_49=""       # Dodo product ID for $49 templates
DODO_PRODUCT_TEMPLATE_99=""       # Dodo product ID for $99 templates
DODO_PRODUCT_PLATFORM=""          # Dodo product ID for $79/mo platform subscription

# Redis (Upstash — optional for local dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend (email — magic link auth + notifications)
RESEND_API_KEY=

# Admin
ADMIN_EMAILS=

# Feature Flags
ENABLE_CLOUD_DEPLOY=true

# Container Infrastructure (Railway — see docs/CONTAINER_INFRASTRUCTURE.md)
RAILWAY_API_TOKEN=""               # Railway API token (Account Settings → Tokens)
RAILWAY_PROJECT_ID=""              # Railway project ID
RAILWAY_ENVIRONMENT_ID=""          # Railway environment ID (production)
OPENCLAW_DOCKER_IMAGE=""           # e.g., ghcr.io/laxcorp-research/openclaw-runtime:latest
GHCR_USERNAME=""                   # GitHub username for private image pulls
GHCR_PAT=""                        # GitHub PAT with packages:read scope

# Logging (Axiom)
AXIOM_TOKEN=""
NEXT_PUBLIC_AXIOM_TOKEN=""
AXIOM_DATASET=""

# Sentry
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN=""

# External Services (optional)
COMPOSIO_API_KEY=""                # Composio OAuth tool integrations
ANTHROPIC_PLATFORM_KEY=""          # Used for LLM-based security review of published templates

# Testing / CI
E2E_TEST_MODE=false
CRON_SECRET=""                     # Secret for Vercel cron job auth

# Image Pipeline (build-openclaw-image.yml + promote-openclaw-image.yml)
# Shared 32-byte hex secret. Workflows POST to /api/internal/versions/register
# with header `X-Pipeline-Secret`. Must match in GitHub Actions repo secret
# `VERSION_PIPELINE_SECRET` and Vercel env (staging + production).
VERSION_PIPELINE_SECRET=""

# Marketplace Layer-2 sandbox (PR-4) — NEW NAMES (flagged)
# SANDBOX_VETTING_ENABLED=true enables VERIFIED mint + refuse-approve-without-sandbox
SANDBOX_VETTING_ENABLED="false"
# Shared with GHA secret SANDBOX_REPORT_TOKEN (intake auth header X-Sandbox-Report-Token)
SANDBOX_REPORT_TOKEN=""
# PAT with actions:write to workflow_dispatch marketplace-skill-sandbox.yml
SANDBOX_GITHUB_DISPATCH_TOKEN=""
# Optional overrides
SANDBOX_GITHUB_REPO="Laxcorp-Research/claws"
SANDBOX_GITHUB_REF="staging"
SANDBOX_INTAKE_BASE_URL="https://staging.app.buildclaws.ai"

# Activity Wire (claws-activity-reporter plugin -> /api/internal/activity)
# Shared 32-byte hex secret. The plugin baked into the OpenClaw container
# POSTs agent events to /api/internal/activity/<workspaceId> with header
# `X-Activity-Secret`. Must match in Vercel env (staging + production).
# Optional: also set in GHA repo secrets if any workflow ever posts /activity
# events (none today). Local dev: set in .env.local for the dev container.
ACTIVITY_PIPELINE_SECRET=""
