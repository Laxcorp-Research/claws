# Database (Neon PostgreSQL)
DATABASE_URL="postgres-redacted"
DIRECT_URL="postgres-redacted"

# Auth (NextAuth.js)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption
ENCRYPTION_MASTER_KEY="generate-64-char-hex-string"
ENCRYPTION_KEY_VERSION="v1"

# Dodo Payments
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DODO_PRODUCT_PRO_PLAN=""
DODO_PRODUCT_ENTERPRISE_PLAN=""
DODO_PRODUCT_CLOUD_HOSTING=""

# Redis (Upstash — optional for local dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Feature Flags
ENABLE_CLOUD_DEPLOY=true
ENABLE_SELF_HOSTED_EXPORT=true
MAX_FREE_WORKSPACES=1
