# Database (Neon PostgreSQL)
DATABASE_URL="postgres-redacted"
DIRECT_URL="postgres-redacted"

# Auth (NextAuth.js)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption
ENCRYPTION_MASTER_KEY="generate-64-char-hex-string"
ENCRYPTION_KEY_VERSION="v1"

# Dodo Payments
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DODO_PRODUCT_TEMPLATE_149=""    # Dodo product ID for $149 templates (Creator + Lifestyle)
DODO_PRODUCT_TEMPLATE_199=""    # Dodo product ID for $199 templates (Business Ops + Vertical + Money-Making)
DODO_PRODUCT_TEMPLATE_299=""    # Dodo product ID for $299 templates (Quant Trader)
DODO_PRODUCT_CLAW_PLATFORM=""   # Dodo product ID for $79/mo platform subscription

# Redis (Upstash — optional for local dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Feature Flags
ENABLE_CLOUD_DEPLOY=true
