{
  "buildCommand": "npm run build:deploy",
  "crons": [
    {
      "path": "/api/admin/payouts/release",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reconcile-credit-balances",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reconcile-container-env",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/aggregate-credit-usage",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/credit-pool-monitor",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/hibernation",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/health-monitor",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/connection-health",
      "schedule": "0 * * * *"
    }
  ]
}
