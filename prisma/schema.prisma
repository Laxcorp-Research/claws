model OpenClawVersion {
  id        String   @id @default(cuid())
  version   String   @unique

  isStable  Boolean  @default(false)
  isLatest  Boolean  @default(false)
  isSecurityPatch Boolean @default(false)

  // Version-keyed emission contract ("5.22" | "9.4") - the config shape THIS
  // image's gateway validates. KEEP wake P0 2026-09-13: the generator emitted
  // 9.4 shape unconditionally and every 5.22-18 wake boot-looped on
  // "Invalid config ... agents.defaults: Invalid input". The generator now
  // keys emission off this row property (src/lib/openclaw/runtime-contract.ts).
  // Stamped by the register route from the version string; backfilled by
  // migration for pre-existing rows. DB default covers raw inserts of
  // 5.22-line rows only.
  runtimeContract String @default("5.22")

  // dockerImage MUST point at an immutable :<version> reference (e.g.
  // ghcr.io/laxcorp-research/openclaw-runtime:2026.5.20), never a moving
  // pointer like :latest or :candidate. The deployer reads this field for
  // the current stable row and passes it through to Railway, so a moving
  // pointer here would make Deployment.containerImage unreliable across
  // future :latest rewrites.
  dockerImage String

  // PR-1 provenance fields (nullable; existing rows pre-date the pipeline).
  // Both written by the image pipeline's /api/internal/versions/register call.
  imageDigest    String?  // sha256:... - immutable digest of the manifest the dockerImage tag resolves to at push time
  buildSourceTag String?  // upstream git tag the image was built from (e.g. "v2026.5.20")

  releaseNotes    String? @db.Text  // free-form notes, or a URL to upstream changelog
  breakingChanges String? @db.Text

  releasedAt DateTime
  stableAt   DateTime?
  testedAt   DateTime?

  // RUNTIME-9.4 PR-3: autoupdate lane. Orphan unpromoted candidates get
  // supersededAt so they stop stale-pinging. soakGreenAt is the 24h soak
  // signal. lastStalePingAt / lastSoakAlertAt prevent silent drops while
  // still rate-limiting pings to once per day.
  supersededAt     DateTime?
  soakGreenAt      DateTime?
  lastStalePingAt  DateTime?
  lastSoakAlertAt  DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

