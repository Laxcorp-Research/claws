// ─── CONTAINER STATE (HIBERNATION) ─────────────────────

model ContainerState {
  id                        String         @id @default(cuid())
  workspaceId               String         @unique

  containerPhase            ContainerPhase @default(STOPPED)
  lastActiveAt              DateTime?
  hibernatedAt              DateTime?
  wakeRequestedAt           DateTime?

  nextHeartbeatAt           DateTime?
  heartbeatInterval         Int?
  heartbeatCronExpressions  String?        @db.Text

  hasActiveChannels         Boolean        @default(false)
  /// First time channels became active on this row; preserved across redeploy.
  /// P1.1 warmIdle: null lastChannelMessageAt + channelsConnectedAt >24h ago
  /// may hibernate (P5 wakes on inbound). Fresh connect stays protected.
  channelsConnectedAt       DateTime?
  lastChannelMessageAt      DateTime?

  activeMinutesToday        Int            @default(0)
  lastResetDate             DateTime       @default(now())

  lastWakeDurationMs        Int?
  avgWakeDurationMs         Int?

  savedVolumeId             String?
  savedContainerConfig      String?        @db.Text

  runtimeStateSnapshot      Bytes?
  runtimeStateUpdatedAt     DateTime?
  runtimeStateSizeBytes     Int?

  // ─── Snapshot generations (rollback material) ─────────────────────────
  // Founder-claw incident 2026-09-13: runtimeStateSnapshot was a single
  // column, so the first 9.4 persist overwrote the last 5.22-shaped snapshot
  // and the rollback material was gone. Every persist now shifts
  // current -> prev inside the SAME atomic UPDATE (persistRuntimeStateSnapshot).
  // Never reintroduce a single-generation overwrite.
  runtimeStatePrevSnapshot  Bytes?
  runtimeStatePrevUpdatedAt DateTime?
  runtimeStatePrevSizeBytes Int?

  // Contract of the bytes currently in runtimeStateSnapshot ("5.22" | "9.4");
  // stamped at persist time from deployedRuntimeContract.
  runtimeStateContract      String?

  // Contract of the image this workspace is currently deployed on; stamped by
  // deployToCloud from the resolved OpenClawVersion row. The first persist
  // after a contract change pins the last old-contract snapshot below.
  deployedRuntimeContract   String?

  // Pre-migration generation: last snapshot taken on the OLD contract, pinned
  // for 7 days after the claw first persists on the new runtime. Rollback =
  // repin the old version + restore these bytes (session history recorded
  // after the migration is lost - the promote card states this plainly).
  preMigrationSnapshot      Bytes?
  preMigrationContract      String?
  preMigrationTakenAt       DateTime?
  preMigrationPinnedUntil   DateTime?

  // PR-2 (syncThenDestroy): teardown-time snapshot freshness marker. When a
  // Stop/hibernate routes through syncThenDestroy and the pre-destroy
  // /internal/sync-now call does NOT confirm a persist (non-200, timeout, or
  // unreachable container), we record the failure here and destroy anyway -
  // so this row's runtimeStateSnapshot may lag the container's last live
  // state. Cleared (both NULL) on a confirmed sync and reset on the next
  // deployToCloud upsert (a fresh container makes prior staleness moot).
  // Mirrors the Workspace.lastHealthCheck / lastHealthReason pairing.
  lastSyncIncompleteAt      DateTime?
  lastSyncIncompleteReason  String?

  workspace                 Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([containerPhase])
  @@index([nextHeartbeatAt])
}

// ─── RAILWAY DEPLOY GOVERNOR ────────────────────────────────
// Account-wide serviceCreate quota (not workspace-scoped). ActivityLog cannot
// be the ledger: it is per-workspace JSON metadata with no global rolling
// index. Rows MUST survive workspace delete - Railway still counts the create.

model RailwayCreateLedger {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  workspaceId String
  serviceId   String?

  @@index([createdAt])
  @@index([workspaceId])
}

model ProvisioningQueue {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  enqueuedAt    DateTime  @default(now())
  /// "budget" | "railway_quota"
  reason        String
  etaAt         DateTime
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([enqueuedAt])
}

/// Singleton (id = "default"). quotaHoldUntil is set when Railway rejects a
/// create with the account-wide cap even if our ledger is empty/under count.
model RailwayGovernorState {
  id             String    @id
  quotaHoldUntil DateTime?
  updatedAt      DateTime  @updatedAt
}

// ─── RAILWAY SERVICE POOL ───────────────────────────────────
// Pre-created empty Railway services banked against the 25/day serviceCreate
// cap. deployToCloud checks a READY entry out BEFORE ever calling
// serviceCreate; terminal teardown (Stop / delete / enforcement) recycles the
// service back instead of serviceDelete. State machine:
//   READY -> ASSIGNED (checkout) -> RECYCLING (teardown) -> READY (receipted)
// PRIVACY INVARIANT: RECYCLING -> READY only after env wipe + volume destroy
// (verified zero remain) + rename are ALL receipted - see
// src/lib/railway/service-pool.ts. A row that fails any step stays RECYCLING
// (never handed to another tenant) until the sweeper completes the wipe.

enum ServicePoolState {
  READY
  ASSIGNED
  RECYCLING
}

model ServicePool {
  id          String           @id @default(cuid())
  /// Railway service id - one row per banked service, ever.
  serviceId   String           @unique
  /// Railway-issued *.up.railway.app hostname. Kept across recycles (domain
  /// reuse - no serviceDomainCreate on checkout). Null when the mint failed
  /// at bank time; ensureServiceDomain heals it at checkout.
  domain      String?
  state       ServicePoolState @default(READY)
  /// Workspace the service is checked out to (ASSIGNED) or was last used by
  /// (RECYCLING provenance). Cleared on READY. Deliberately NOT a relation:
  /// pool rows must survive workspace delete (same rule as RailwayCreateLedger).
  workspaceId String?
  lastError   String?
  assignedAt  DateTime?
  recycledAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([state])
  @@index([workspaceId])
}

/// Singleton (id = "default"): pool low-watermark alert bookkeeping.
/// highWatermark mutes the expected-empty ramp (low alert fires only after
/// the pool has EVER reached the floor); lowAlertSentAt is the 12h re-alert
/// cadence stamp.
model ServicePoolMeta {
  id             String    @id
  highWatermark  Int       @default(0)
  lowAlertSentAt DateTime?
  updatedAt      DateTime  @updatedAt
}

// ─── LEGAL CONSENT AUDIT TRAIL ──────────────────────────────

/// See src/lib/legal/consent.ts for the capture points and version rules.
enum ConsentKind {
  /// Signup checkbox: "I agree to the Terms and Privacy Policy"
  TOS_PRIVACY
  /// First deploy of a financial template: "I've read the AI & autonomy terms (§8)"
  FINANCIAL_AUTONOMY_S8
  /// Ask-before-acting -> Autonomous knob flip (risk line links §8)
  AUTONOMOUS_MODE_S8
}

/// Append-only legal evidence. Deliberately NO relations: consent proof must
/// survive workspace AND user deletion (same audit-row rule as
/// RailwayCreateLedger). Multiple rows per (user, kind) are expected - one
/// per version consented / per autonomy flip.
model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  kind        ConsentKind
  /// Legal-doc version consented to (ToS effective date, e.g. "2026-08").
  version     String
  workspaceId String?
  /// Capture point: signup | signin-lazy | deploy-gate | knob-write
  source      String
  metadata    String?
  acceptedAt  DateTime    @default(now())

  @@index([userId, kind])
  @@index([workspaceId, kind])
}
