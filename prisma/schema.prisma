generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // PR-2d note: Prisma 7 explicitly REMOVED schema-level `url` and
  // `directUrl` declarations (validate errors P1012 if you add them
  // back). Connection URLs live ONLY in prisma.config.ts on Prisma 7+.
  // See docs/MIGRATIONS.md and https://pris.ly/d/config-datasource.
}

// ─── AUTH & USERS ───────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  avatarUrl       String?
  emailVerified   DateTime?
  hashedPassword  String?

  stripeCustomerId    String?   @unique
  dodoCustomerId      String?   @unique
  hasActiveSubscription Boolean @default(false)
  subscriptionId      String?
  subscriptionEndsAt  DateTime?

  monthlyApiSpendLimit Float    @default(50.0)

  onboardingCompleted Boolean   @default(false)

  trialUsed       Boolean   @default(false)
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  // GRACE-24: stamped when the expiry-notify email is sent. Stop phase
  // anchors on this (+24h), never on trialEndsAt - so retroactive first
  // runs notify now and stop at notify+24h.
  trialExpiryNotifiedAt DateTime?
  // Dodo subscription lifecycle: "active" | "on_hold" | "cancelled" |
  // "failed" | "expired". on_hold = dunning; the 24h trial stop skips it.
  // The 14-day cap (subscriptionOnHoldAt) is terminal.
  subscriptionStatus String?
  // First subscription.on_hold. Not overwritten by repeat webhooks.
  // Cleared on subscription.active. Null + on_hold: cron backfills from
  // the earliest "Nudge: subscription-on-hold" activity row.
  subscriptionOnHoldAt DateTime?
  // Day-7 win-back email. Null until Resend accepts the send.
  trialWinbackSentAt DateTime?
  // Account-deletion grace. Purge cron hard-deletes 14 days later.
  // Null = no request. Cleared by cancel.
  deletionRequestedAt DateTime?

  creditAccount            CreditAccount?
  apiKeySource             ApiKeySource    @default(NONE)
  emailVerifiedForCredits  Boolean         @default(false)

  accounts        Account[]
  sessions        Session[]
  workspaces      Workspace[]
  purchases       Purchase[]
  apiKeys         UserApiKey[]
  auditLogs       AuditLog[]
  creatorProfile   CreatorProfile?
  templateReviews  TemplateReview[]
  skillReviews     SkillReview[]
  templateInstalls TemplateInstall[]
  skillInstalls    SkillInstall[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([stripeCustomerId])
}

// SubscriptionTier removed - flat pricing: buy template + $79/mo per Claw

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── API KEY MANAGEMENT ─────────────────────────────────

model UserApiKey {
  id          String   @id @default(cuid())
  userId      String
  provider    ApiProvider

  encryptedKey String
  keyHint     String
  label       String?

  isValid     Boolean  @default(true)
  lastUsedAt  DateTime?
  lastError   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model WorkspaceApiKey {
  id            String      @id @default(cuid())
  workspaceId   String
  provider      ApiProvider

  encryptedKey  String
  keyHint       String

  isValid       Boolean     @default(false)
  lastValidatedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

enum ApiProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
  OPENROUTER
  OLLAMA
}

/// Dynamic model registry - refreshed from provider APIs (OpenRouter /models, etc.).
/// Agent.model stores the OpenClaw ref (e.g. anthropic/…, openrouter/openai/gpt-4o).
model ModelCatalogEntry {
  id                 String   @id @default(cuid())
  /// OpenClaw model ref used in Agent.model / openclaw.json
  modelId            String   @unique
  /// ANTHROPIC | OPENAI | GOOGLE | OPENROUTER
  provider           String
  displayName        String
  contextLength      Int?
  /// Short pricing snippet for UI (e.g. "$0.15/$0.60 per 1M")
  pricingSnippet     String?
  /// Rough est. USD per 1k calls for legacy cost column (estimate-only for BYOK)
  costPer1kEst       Float?
  /// Adjustable thinking/reasoning support. true/false from provider metadata
  /// (OpenRouter supported_parameters, Anthropic version heuristic);
  /// null = unknown (UI keeps the thinking control enabled; runtime ignores
  /// the level on models that lack reasoning).
  supportsReasoning  Boolean?
  isPinned           Boolean  @default(false)
  isActive           Boolean  @default(true)
  /// seed | openrouter | openai | google | anthropic
  source             String
  rawMeta            Json?
  refreshedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([provider])
  @@index([isPinned, isActive])
  @@index([displayName])
}

// ─── WORKSPACES ─────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?

  status      WorkspaceStatus @default(DRAFT)

  /// Which cloud runs this claw's container. RAILWAY is the incumbent
  /// (service per claw); FLY is the Machines adapter (app + machine per
  /// claw, HWD = native machine stop/start). Stamped at first provision
  /// (NEW_WORKSPACE_PROVIDER flag) or by migrate-on-wake
  /// (MIGRATE_ON_WAKE_TO). Governor + service pool are RAILWAY-only.
  provider    CloudProvider   @default(RAILWAY)

  containerId     String?
  containerName   String?
  containerHost   String?
  containerPort   Int?
  hostPort        Int?
  gatewayToken    String?
  // PR-9/A-vercel: AES-256-GCM-encrypted JSON blob
  // {deviceId, publicKeyRawB64u, privateKeyPem} - the Ed25519 device
  // identity the chat send endpoint presents to the workspace's gateway
  // (remote clients without a device identity get their scopes cleared;
  // see docs/OPENCLAW_GATEWAY_PROTOCOL.md §3). Generated LAZILY on first
  // send; NULL until then. Single blob (not split columns): the triple is
  // read/written atomically and never queried by part.
  chatDeviceKeyEncrypted String?
  timezone        String?  @default("UTC")
  lastHealthCheck DateTime?
  healthStatus    HealthStatus @default(UNKNOWN)
  // PR-3: Health monitor debounce counter. Incremented on each failed
  // /api/v1/admin/rpc health probe (HTTP error, timeout, or ok:false envelope)
  // and reset to 0 on success. Reaching 2 flips healthStatus to UNHEALTHY;
  // reaching 5 also flips status to ERROR. Default 0; never null.
  // See src/app/api/cron/health-monitor/route.ts for the algorithm.
  consecutiveHealthFailures Int @default(0)
  // PR-4: last health-probe classification reason, written by the health
  // monitor every pass. One of the ProbeResult reasons (e.g.
  // "plugin-not-loaded", "no-agents", "timeout", "healthy"). The dashboard
  // reads this to pick the correct banner - distinguishing config drift
  // (4xx: alive-but-misconfigured) from a genuinely unreachable container
  // (5xx/timeout). Null until the first probe writes it.
  lastHealthReason String?

  // PR-8a/C: rotation cursor for the env-reconciliation cron. Stamped with
  // now() after each reconcile check; the cron orders by this ASC (NULLS
  // FIRST) so never-checked (null) and least-recently-checked workspaces get
  // priority, giving fair rotation under the per-tick cap. Distinct from
  // lastHealthCheck, which the health monitor owns.
  lastEnvReconcileAt DateTime?

  channelConfigEncrypted String?

  currentMonthApiCost Float    @default(0)
  apiSpendLimit       Float    @default(50.0)
  costAlertThreshold  Float    @default(0.8)
  costAlertSent       Boolean  @default(false)

  clawTemplateId String?

  // Tool customization PR-1: per-workspace copy of template snapshot tools[]
  // (required / recommended). Null = legacy install → dual-read falls back to
  // ClawTemplate.workspaceSnapshot.tools. Seeded at createWorkspaceFromTemplate;
  // mutated via PATCH /api/workspaces/[id]/tool-requirements. Template JSON
  // stays intact for the next buyer.
  toolRequirements Json?

  // INFRA-2: per-workspace copy of template snapshot files[] (birth stubs).
  // Null = legacy install → dual-read falls back to ClawTemplate.workspaceSnapshot.files.
  // Seeded at createWorkspaceFromTemplate. Template JSON stays intact for the next buyer.
  // Community publish MUST omit files[] (privacy rail v1).
  seedFiles Json?

  // INFRA-1: first-boot USER.md interview completed (workspace flag, no canvas).
  // Null = orchestrator BOOT.md still carries the coverage pack. Set once via
  // activity token CLAWS_USER_MD_INTERVIEW_COMPLETE; redeploy never re-interviews.
  userMdInterviewCompletedAt DateTime?

  containerState           ContainerState?
  apiKeySourceOverride     ApiKeySource?

  // C-engine B1: Composio Tool Router session id (trs_...) for the MCP
  // long-tail path. Written by the generator's reuse-or-create step when
  // CLAWS_MCP_LONGTAIL_ENABLED=true and the workspace has uncurated
  // connected tools. Workspace-lifetime (survives redeploys - the session
  // is reused when its toolkit set matches; recreated on drift). Null for
  // curated-only workspaces and while the flag is off.
  composioToolRouterSessionId String?
  mcpSessionHealthStatus      String?
  mcpSessionCheckedAt         DateTime?
  mcpSessionLastError         String?
  activitySilenceDetectedAt   DateTime?
  stateSyncStaleDetectedAt    DateTime?
  // Cry-wolf guard (PR-C #13): consecutive stale-snapshot probes seen by the
  // health monitor. stateSyncStaleDetectedAt is only set once this reaches 2
  // - a single blip (e.g. mid-sync probe timing) must not banner. Reset to 0
  // the moment a probe sees a fresh snapshot. See decideStateSyncStale in
  // src/app/api/cron/health-monitor/route.ts.
  stateSyncStaleConsecutive   Int       @default(0)
  // Lifecycle P2: Watchtower missed-window flag (cron heartbeat). Distinct
  // from activitySilenceDetectedAt. Banner feeds AlertStack ops-gap slot (4).
  heartbeatMissedAt           DateTime?
  // Lifecycle P3: auto-hibernate refused (sync-fail / stale snapshot).
  // Banner feeds AlertStack DATA class slot (priority 6 with state-sync-stale).
  hibernationRefusedAt        DateTime?
  // PR-C #10: opt out of the hibernation sweep entirely (higher hosting cost,
  // zero cold-start latency). Dashboard-only toggle - deliberately EXCLUDED
  // from the config-fingerprint workspace projection (does not affect the
  // generated container config, only the hibernation cron's candidate query).
  // See src/lib/hibernation/predicates.ts (runningIdleWhere / warmIdleWhere).
  alwaysOn                    Boolean   @default(false)

  // WIRE-FULL choreography knobs (fingerprint v4). Generator inputs only -
  // ships locked to APPROVAL_REQUIRED language this arc; AUTO_PROCEED is
  // schema-present, UI-disabled until action integrations are connected.
  maxRevisionRounds           Int            @default(3)
  deliveryMode                DeliveryMode   @default(APPROVAL_REQUIRED)

  // INFRA-5b: HTTP fixture rail for staging rigs. Control plane ignores this
  // when CLAWS_ENV=production even if true. Default false.
  httpFixtureMode             Boolean        @default(false)

  // RUNTIME-9.4 PR-2: per-workspace candidate image soak. Deployer may read
  // OpenClawVersion.isLatest (isCandidate register) instead of isStable.
  // Honored only for flagged staging clones; KEEP canary and production
  // CLAWS_ENV always stay on isStable. Default false. Not a generator input
  // (fingerprint-excluded).
  candidateRuntimeSoak        Boolean        @default(false)

  // Explicit per-workspace runtime pin: an OpenClawVersion.version string
  // (e.g. "2026.9.4-5"). Highest-priority image resolution - above candidate
  // soak and above isStable. A pinned workspace never chases isLatest and
  // never falls back to stable; deploy THROWS if the pinned version has no
  // row. Set for the founder claw after its 5.22 snapshot was overwritten by
  // a 9.4 persist (its history is 9.4-only now - a silent 5.22-18 fallback
  // on wake would boot into an image that cannot read that history).
  // NULL = normal resolution.
  runtimeImagePin             String?

  // PR-B: opt out of critical-alert pushes (Telegram, fallback email) for
  // container-unhealthy / cron-job-failed / heartbeat-missed / state-sync-stale.
  // Default false → alerts ON by default. See src/lib/alerts/critical-alert-push.ts.
  criticalAlertsOptOut        Boolean   @default(false)

  // ─── PR1: per-workspace subscription state ──────────────────
  // Part of the billing-model overhaul (PR1-9 sequence). This PR only
  // adds the columns; PR3 will start populating them via the Dodo webhook
  // (dual-write alongside User.hasActiveSubscription), and PR5 will cut
  // the eligibility-check reads over to these fields. No code path in
  // this PR writes or reads these - all nullable, all unused until PR3.
  subscriptionId      String?             @unique
  subscriptionStatus  SubscriptionStatus?
  currentPeriodEnd    DateTime?           // Maps from Dodo's next_billing_date
  canceledAt          DateTime?           // Set when cancellation takes effect (period-end), not at click time
  stateRetainedUntil  DateTime?           // canceledAt + 30 days; populated at end-of-period destroy

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clawTemplate ClawTemplate? @relation(fields: [clawTemplateId], references: [id])
  agents      Agent[]
  connections AgentConnection[]
  activityLogs ActivityLog[]
  provisioningQueue ProvisioningQueue?
  deployments  Deployment[]
  toolConnections ToolConnection[]
  customToolConnections CustomToolConnection[]
  snapshots   WorkspaceSnapshot[]
  fileVersions FileVersion[]
  auditLogs   AuditLog[]
  apiKeyOverrides WorkspaceApiKey[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([containerId])
  @@index([lastEnvReconcileAt])
  @@index([subscriptionStatus, currentPeriodEnd])
}

enum WorkspaceStatus {
  DRAFT
  SETUP_INCOMPLETE
  DEPLOYING
  RUNNING
  PAUSED
  HIBERNATED
  WAKING
  ERROR
  STOPPED
  /// Honest wait: Railway serviceCreate is over daily cap. Not ERROR.
  PROVISIONING_QUEUED
}

/// Fly adapter: container cloud per workspace. See docs/FLY_MACHINES_ADAPTER.md.
enum CloudProvider {
  RAILWAY
  FLY
}

// DeploymentType removed - cloud-only platform

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

// ─── AGENTS ─────────────────────────────────────────────

model Agent {
  id            String   @id @default(cuid())
  workspaceId   String
  agentSlug     String

  name          String
  roleDescription String?
  description   String?
  color         String   @default("#5BA1F5")
  icon          String?

  soulMd        String   @db.Text
  agentsMd      String   @db.Text
  heartbeatMd   String?  @db.Text
  toolsMd       String?  @db.Text
  userMd        String?  @db.Text
  identityMd    String?  @db.Text

  heartbeatFrequency String?
  heartbeatTime      String?

  model         String   @default("anthropic/claude-sonnet-4-6")
  fallbackModel String?
  // OpenClaw agents.list[].thinkingDefault: off|minimal|low|medium|high.
  // null = omit from config (runtime default). Validated app-side (lib/models/thinking.ts).
  thinkingDefault String?

  skills        AgentSkill[]

  positionX     Float    @default(0)
  positionY     Float    @default(0)

  role          AgentRole  @default(WORKER)
  reportsTo     String?
  maxRetries    Int        @default(3)
  qualityThreshold Float   @default(8.0)
  isPaused      Boolean    @default(false)
  lastActiveAt  DateTime?

  outgoingConnections AgentConnection[] @relation("SourceAgent")
  incomingConnections AgentConnection[] @relation("TargetAgent")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, agentSlug])
  @@index([workspaceId])
}

model AgentSkill {
  id        String @id @default(cuid())
  agentId   String
  skillId   String

  configOverrides String? @db.Text

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
}

// ─── AGENT CONNECTIONS ──────────────────────────────────

model AgentConnection {
  id            String @id @default(cuid())
  workspaceId   String
  sourceAgentId String
  targetAgentId String

  // WIRE-FULL X2: solid ORCH→WORKER edges are unconditional delegation.
  // Seeds/API write ON_COMPLETE uniformly. Generator IGNORES this column.
  // ON_SCHEDULE / ON_HUMAN_APPROVE / ON_APPROVAL / ON_REJECTION / CUSTOM
  // are dormant (no enum migration) - kept for schema stability only.
  condition     ConnectionCondition @default(ON_COMPLETE)
  conditionExpr String?
  label         String?
  // Optional ≤140-char note woven into the generated delegation sentence.
  contextNote   String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAgent Agent     @relation("SourceAgent", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  targetAgent Agent     @relation("TargetAgent", fields: [targetAgentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceAgentId])
  @@index([targetAgentId])
}

enum ConnectionCondition {
  ON_COMPLETE
  ON_APPROVAL
  ON_REJECTION
  ON_SCHEDULE
  ON_HUMAN_APPROVE
  CUSTOM
}

enum DeliveryMode {
  APPROVAL_REQUIRED
  AUTO_PROCEED
}

// ─── SKILLS LIBRARY ─────────────────────────────────────

model Skill {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String

  skillMd     String @db.Text

  type        SkillType
  category    SkillCategory
  icon        String?
  emoji       String?

  compatibleTools  String[]
  requiresToolConnection  Boolean @default(false)
  requiredToolCategory    String?
  /// Marketplace / custom skill binary canaries (generator → SKILL.md requires.bins).
  requiredBins String[] @default([])
  /// Marketplace env names (generator → SKILL.md requires.env + skills.entries).
  requiredEnvVars String[] @default([])

  isVerified  Boolean @default(false)
  isBuiltIn   Boolean @default(false)
  isCurated   Boolean @default(true)
  version     Int     @default(1)

  permissions   String[]
  securityNotes String?

  agentSkills AgentSkill[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, category])
  @@index([category])
}

enum SkillType {
  BUILT_IN
  TOOL_SPECIFIC
  TOOL_AGNOSTIC
  DOMAIN_WORKFLOW
  USER_GENERATED
}

enum SkillCategory {
  CORE
  CRM
  EMAIL_SENDER
  EMAIL_READER
  LEAD_DATABASE
  ENRICHMENT
  SOCIAL
  CALENDAR
  PROJECT_MGMT
  ANALYTICS
  SEARCH
  FINANCE
  TRADING
  CONTENT
  COMMUNICATION
  SECURITY
  CUSTOM
}

enum AgentRole {
  ORCHESTRATOR
  WORKER
  CRITIC
}

// ─── MARKETPLACE ENUMS ─────────────────────────────────

enum TrustTier {
  UNREVIEWED
  SCANNED
  VERIFIED
  OFFICIAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum PayoutStatus {
  PENDING
  RELEASABLE
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum ReportReason {
  MALICIOUS
  MISLEADING
  COPYRIGHT
  SPAM
  INAPPROPRIATE
  BROKEN
  NAME_CONFLICT
}

// ─── TOOL CONNECTIONS ───────────────────────────────────

model ToolConnection {
  id           String   @id @default(cuid())
  workspaceId  String
  toolSlug     String

  connectionType ConnectionType
  displayName    String

  // encryptedCredentials holds an AES-256-GCM encrypted JSON string of the
  // credential map, keyed by env-var name (matches credentialFields in
  // src/data/tool-catalog.ts). Example payload after decrypt:
  //   {"BINANCE_API_KEY":"...", "BINANCE_API_SECRET":"..."}
  // Single-cred tools produce a one-key object; multi-cred tools produce
  // N keys matching their catalog-declared credentialFields. OAUTH_COMPOSIO
  // and CHANNEL_NATIVE rows leave this null.
  encryptedCredentials String?

  keyHint         String?

  composioConnectionId String?
  composioEntityId     String?

  status       ToolConnectionStatus @default(PENDING)
  lastTestedAt DateTime?
  lastError    String?
  lastConnectionCheckAt     DateTime?
  lastConnectionCheckResult String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, toolSlug])
  @@index([workspaceId])
}

enum ConnectionType {
  API_KEY
  OAUTH_COMPOSIO
  CHANNEL_NATIVE
  NO_AUTH
}

enum ToolConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
  REVOKED
  // NEEDS_CREDENTIALS: the backfill migrated partial data (e.g. a multi-cred
  // tool with only the primary API key but missing secret/passphrase). UI
  // renders this with an amber badge and a "Complete" button that reopens
  // the CredentialsModal pre-filled with the known field. Terminal states
  // from here are CONNECTED (once user supplies the rest) or ERROR.
  NEEDS_CREDENTIALS
}

// ─── CUSTOM TOOL CONNECTIONS ────────────────────────────

model CustomToolConnection {
  id           String @id @default(cuid())
  workspaceId  String
  name         String
  baseUrl      String
  authType     CustomAuthType
  encryptedCredentials String
  description  String?

  generatedSkillMd String? @db.Text

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

enum CustomAuthType {
  API_KEY_HEADER
  BEARER_TOKEN
  BASIC_AUTH
  QUERY_PARAM
}

// ─── CLAW TEMPLATES ─────────────────────────────────────

model ClawTemplate {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  tagline     String
  description String @db.Text

  category    ClawCategory
  tags        String[]

  price       Float
  isFree      Boolean @default(false)

  agentCount  Int
  previewImage String?
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  creatorId   String?
  creator     CreatorProfile? @relation(fields: [creatorId], references: [id])

  trustTier    TrustTier    @default(UNREVIEWED)
  reviewStatus    ReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  autoScanPassed  Boolean?
  autoScanReport  String?   @db.Text

  version            Int     @default(1)
  minOpenClawVersion String?
  testedOnVersion    String?

  estimatedMonthlyCost String?

  dodoProductId        String?

  workspaceSnapshot String @db.Text

  /// PR-2 republish: pending snapshot stays off-store until admin approve.
  /// Live workspaceSnapshot + isPublished stay public while this is set.
  pendingWorkspaceSnapshot String?   @db.Text
  pendingVersion           Int?
  pendingSubmittedAt       DateTime?

  purchaseCount Int @default(0)
  installCount  Int @default(0)
  avgRating     Float?

  workspaces Workspace[]
  purchases  Purchase[]
  reviews    TemplateReview[]
  installs   TemplateInstall[]
  sales      MarketplaceSale[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([trustTier])
  @@index([isPublished])
  @@index([creatorId])
  @@index([installCount])
  @@index([pendingSubmittedAt])
}

enum ClawCategory {
  MONEY_MAKING
  CREATOR
  BUSINESS_OPS
  VERTICAL
  LIFESTYLE
}

model TemplateReview {
  id             String @id @default(cuid())
  clawTemplateId String
  userId         String

  rating         Int
  title          String?
  body           String?  @db.Text
  verifiedInstall Boolean @default(false)

  template ClawTemplate @relation(fields: [clawTemplateId], references: [id], onDelete: Cascade)
