generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // PR-2d note: Prisma 7 explicitly REMOVED schema-level `url` and
  // `directUrl` declarations (validate errors P1012 if you add them
  // back). Connection URLs live ONLY in prisma.config.ts on Prisma 7+.
  // See docs/MIGRATIONS.md and https://pris.ly/d/config-datasource.
}

// ─── AUTH & USERS ───────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  avatarUrl       String?
  emailVerified   DateTime?
  hashedPassword  String?

  stripeCustomerId    String?   @unique
  dodoCustomerId      String?   @unique
  hasActiveSubscription Boolean @default(false)
  subscriptionId      String?
  subscriptionEndsAt  DateTime?

  monthlyApiSpendLimit Float    @default(50.0)

  onboardingCompleted Boolean   @default(false)

  trialUsed       Boolean   @default(false)
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?

  creditAccount            CreditAccount?
  apiKeySource             ApiKeySource    @default(NONE)
  emailVerifiedForCredits  Boolean         @default(false)

  accounts        Account[]
  sessions        Session[]
  workspaces      Workspace[]
  purchases       Purchase[]
  apiKeys         UserApiKey[]
  auditLogs       AuditLog[]
  creatorProfile   CreatorProfile?
  templateReviews  TemplateReview[]
  skillReviews     SkillReview[]
  templateInstalls TemplateInstall[]
  skillInstalls    SkillInstall[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([stripeCustomerId])
}

// SubscriptionTier removed — flat pricing: buy template + $79/mo per Claw

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── API KEY MANAGEMENT ─────────────────────────────────

model UserApiKey {
  id          String   @id @default(cuid())
  userId      String
  provider    ApiProvider

  encryptedKey String
  keyHint     String
  label       String?

  isValid     Boolean  @default(true)
  lastUsedAt  DateTime?
  lastError   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model WorkspaceApiKey {
  id            String      @id @default(cuid())
  workspaceId   String
  provider      ApiProvider

  encryptedKey  String
  keyHint       String

  isValid       Boolean     @default(false)
  lastValidatedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

enum ApiProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
  OPENROUTER
  OLLAMA
}

// ─── WORKSPACES ─────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?

  status      WorkspaceStatus @default(DRAFT)

  containerId     String?
  containerName   String?
  containerHost   String?
  containerPort   Int?
  hostPort        Int?
  gatewayToken    String?
  timezone        String?  @default("UTC")
  lastHealthCheck DateTime?
  healthStatus    HealthStatus @default(UNKNOWN)
  // PR-3: Health monitor debounce counter. Incremented on each failed
  // /api/v1/admin/rpc health probe (HTTP error, timeout, or ok:false envelope)
  // and reset to 0 on success. Reaching 2 flips healthStatus to UNHEALTHY;
  // reaching 5 also flips status to ERROR. Default 0; never null.
  // See src/app/api/cron/health-monitor/route.ts for the algorithm.
  consecutiveHealthFailures Int @default(0)
  // PR-4: last health-probe classification reason, written by the health
  // monitor every pass. One of the ProbeResult reasons (e.g.
  // "plugin-not-loaded", "no-agents", "timeout", "healthy"). The dashboard
  // reads this to pick the correct banner — distinguishing config drift
  // (4xx: alive-but-misconfigured) from a genuinely unreachable container
  // (5xx/timeout). Null until the first probe writes it.
  lastHealthReason String?

  // PR-8a/C: rotation cursor for the env-reconciliation cron. Stamped with
  // now() after each reconcile check; the cron orders by this ASC (NULLS
  // FIRST) so never-checked (null) and least-recently-checked workspaces get
  // priority, giving fair rotation under the per-tick cap. Distinct from
  // lastHealthCheck, which the health monitor owns.
  lastEnvReconcileAt DateTime?

  channelConfigEncrypted String?

  currentMonthApiCost Float    @default(0)
  apiSpendLimit       Float    @default(50.0)
  costAlertThreshold  Float    @default(0.8)
  costAlertSent       Boolean  @default(false)

  clawTemplateId String?

  containerState           ContainerState?
  apiKeySourceOverride     ApiKeySource?

  // ─── PR1: per-workspace subscription state ──────────────────
  // Part of the billing-model overhaul (PR1-9 sequence). This PR only
  // adds the columns; PR3 will start populating them via the Dodo webhook
  // (dual-write alongside User.hasActiveSubscription), and PR5 will cut
  // the eligibility-check reads over to these fields. No code path in
  // this PR writes or reads these — all nullable, all unused until PR3.
  subscriptionId      String?             @unique
  subscriptionStatus  SubscriptionStatus?
  currentPeriodEnd    DateTime?           // Maps from Dodo's next_billing_date
  canceledAt          DateTime?           // Set when cancellation takes effect (period-end), not at click time
  stateRetainedUntil  DateTime?           // canceledAt + 30 days; populated at end-of-period destroy

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clawTemplate ClawTemplate? @relation(fields: [clawTemplateId], references: [id])
  agents      Agent[]
  connections AgentConnection[]
  activityLogs ActivityLog[]
  deployments  Deployment[]
  toolConnections ToolConnection[]
  customToolConnections CustomToolConnection[]
  snapshots   WorkspaceSnapshot[]
  auditLogs   AuditLog[]
  apiKeyOverrides WorkspaceApiKey[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([containerId])
  @@index([lastEnvReconcileAt])
  @@index([subscriptionStatus, currentPeriodEnd])
}

enum WorkspaceStatus {
  DRAFT
  SETUP_INCOMPLETE
  DEPLOYING
  RUNNING
  PAUSED
  HIBERNATED
  WAKING
  ERROR
  STOPPED
}

// DeploymentType removed — cloud-only platform

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

// ─── AGENTS ─────────────────────────────────────────────

model Agent {
  id            String   @id @default(cuid())
  workspaceId   String
  agentSlug     String

  name          String
  roleDescription String?
  description   String?
  color         String   @default("#5BA1F5")
  icon          String?

  soulMd        String   @db.Text
  agentsMd      String   @db.Text
  heartbeatMd   String?  @db.Text
  toolsMd       String?  @db.Text
  userMd        String?  @db.Text
  identityMd    String?  @db.Text

  heartbeatFrequency String?
  heartbeatTime      String?

  model         String   @default("anthropic/claude-sonnet-4-6")
  fallbackModel String?

  skills        AgentSkill[]

  positionX     Float    @default(0)
  positionY     Float    @default(0)

  role          AgentRole  @default(WORKER)
  reportsTo     String?
  maxRetries    Int        @default(3)
  qualityThreshold Float   @default(8.0)
  isPaused      Boolean    @default(false)
  lastActiveAt  DateTime?

  outgoingConnections AgentConnection[] @relation("SourceAgent")
  incomingConnections AgentConnection[] @relation("TargetAgent")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, agentSlug])
  @@index([workspaceId])
}

model AgentSkill {
  id        String @id @default(cuid())
  agentId   String
  skillId   String

  configOverrides String? @db.Text

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
}

// ─── AGENT CONNECTIONS ──────────────────────────────────

model AgentConnection {
  id            String @id @default(cuid())
  workspaceId   String
  sourceAgentId String
  targetAgentId String

  condition     ConnectionCondition @default(ON_COMPLETE)
  conditionExpr String?
  label         String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAgent Agent     @relation("SourceAgent", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  targetAgent Agent     @relation("TargetAgent", fields: [targetAgentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceAgentId])
  @@index([targetAgentId])
}

enum ConnectionCondition {
  ON_COMPLETE
  ON_APPROVAL
  ON_REJECTION
  ON_SCHEDULE
  ON_HUMAN_APPROVE
  CUSTOM
}

// ─── SKILLS LIBRARY ─────────────────────────────────────

model Skill {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String

  skillMd     String @db.Text

  type        SkillType
  category    SkillCategory
  icon        String?

  compatibleTools  String[]
  requiresToolConnection  Boolean @default(false)
  requiredToolCategory    String?

  isVerified  Boolean @default(false)
  isBuiltIn   Boolean @default(false)
  isCurated   Boolean @default(true)
  version     Int     @default(1)

  permissions   String[]
  securityNotes String?

  agentSkills AgentSkill[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, category])
  @@index([category])
}

enum SkillType {
  BUILT_IN
  TOOL_SPECIFIC
  TOOL_AGNOSTIC
  DOMAIN_WORKFLOW
  USER_GENERATED
}

enum SkillCategory {
  CORE
  CRM
  EMAIL_SENDER
  EMAIL_READER
  LEAD_DATABASE
  ENRICHMENT
  SOCIAL
  CALENDAR
  PROJECT_MGMT
  ANALYTICS
  SEARCH
  FINANCE
  TRADING
  CONTENT
  COMMUNICATION
  SECURITY
  CUSTOM
}

enum AgentRole {
  ORCHESTRATOR
  WORKER
  CRITIC
}

// ─── MARKETPLACE ENUMS ─────────────────────────────────

enum TrustTier {
  UNREVIEWED
  SCANNED
  VERIFIED
  OFFICIAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum PayoutStatus {
  PENDING
  RELEASABLE
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum ReportReason {
  MALICIOUS
  MISLEADING
  COPYRIGHT
  SPAM
  INAPPROPRIATE
  BROKEN
  NAME_CONFLICT
}

// ─── TOOL CONNECTIONS ───────────────────────────────────

model ToolConnection {
  id           String   @id @default(cuid())
  workspaceId  String
  toolSlug     String

  connectionType ConnectionType
  displayName    String

  // encryptedCredentials holds an AES-256-GCM encrypted JSON string of the
  // credential map, keyed by env-var name (matches credentialFields in
  // src/data/tool-catalog.ts). Example payload after decrypt:
  //   {"BINANCE_API_KEY":"...", "BINANCE_API_SECRET":"..."}
  // Single-cred tools produce a one-key object; multi-cred tools produce
  // N keys matching their catalog-declared credentialFields. OAUTH_COMPOSIO
  // and CHANNEL_NATIVE rows leave this null.
  encryptedCredentials String?

  keyHint         String?

  composioConnectionId String?
  composioEntityId     String?

  status       ToolConnectionStatus @default(PENDING)
  lastTestedAt DateTime?
  lastError    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, toolSlug])
  @@index([workspaceId])
}

enum ConnectionType {
  API_KEY
  OAUTH_COMPOSIO
  CHANNEL_NATIVE
}

enum ToolConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
  REVOKED
  // NEEDS_CREDENTIALS: the backfill migrated partial data (e.g. a multi-cred
  // tool with only the primary API key but missing secret/passphrase). UI
  // renders this with an amber badge and a "Complete" button that reopens
  // the CredentialsModal pre-filled with the known field. Terminal states
  // from here are CONNECTED (once user supplies the rest) or ERROR.
  NEEDS_CREDENTIALS
}

// ─── CUSTOM TOOL CONNECTIONS ────────────────────────────

model CustomToolConnection {
  id           String @id @default(cuid())
  workspaceId  String
  name         String
  baseUrl      String
  authType     CustomAuthType
  encryptedCredentials String
  description  String?

  generatedSkillMd String? @db.Text

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

enum CustomAuthType {
  API_KEY_HEADER
  BEARER_TOKEN
  BASIC_AUTH
  QUERY_PARAM
}

// ─── CLAW TEMPLATES ─────────────────────────────────────

model ClawTemplate {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  tagline     String
  description String @db.Text

  category    ClawCategory
  tags        String[]

  price       Float
  isFree      Boolean @default(false)

  agentCount  Int
  previewImage String?
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  creatorId   String?
  creator     CreatorProfile? @relation(fields: [creatorId], references: [id])

  trustTier    TrustTier    @default(UNREVIEWED)
  reviewStatus    ReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  autoScanPassed  Boolean?
  autoScanReport  String?   @db.Text

  version            Int     @default(1)
  minOpenClawVersion String?
  testedOnVersion    String?

  estimatedMonthlyCost String?

  dodoProductId        String?

  workspaceSnapshot String @db.Text

  purchaseCount Int @default(0)
  installCount  Int @default(0)
  avgRating     Float?

  workspaces Workspace[]
  purchases  Purchase[]
  reviews    TemplateReview[]
  installs   TemplateInstall[]
  sales      MarketplaceSale[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([trustTier])
  @@index([isPublished])
  @@index([creatorId])
  @@index([installCount])
}

enum ClawCategory {
  MONEY_MAKING
  CREATOR
  BUSINESS_OPS
  VERTICAL
  LIFESTYLE
}

model TemplateReview {
  id             String @id @default(cuid())
  clawTemplateId String
  userId         String

  rating         Int
  title          String?
  body           String?  @db.Text
  verifiedInstall Boolean @default(false)

  template ClawTemplate @relation(fields: [clawTemplateId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clawTemplateId, userId])
  @@index([clawTemplateId])
}

// ─── PURCHASES & BILLING ────────────────────────────────

model Purchase {
  id              String @id @default(cuid())
  userId          String
  clawTemplateId  String
  workspaceId     String?

  amountPaid      Float
  currency        String @default("usd")
  stripePaymentId String? @unique
  stripeInvoiceId String?
  dodoPaymentId   String? @unique
  dodoBusinessId  String?

  subscriptionId  String?
  subscriptionStatus SubscriptionStatus?

  status          PurchaseStatus @default(COMPLETED)
  refundedAt      DateTime?

  user User          @relation(fields: [userId], references: [id])
  clawTemplate ClawTemplate @relation(fields: [clawTemplateId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([clawTemplateId])
  @@index([stripePaymentId])
  @@index([dodoPaymentId])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ─── DEPLOYMENTS ────────────────────────────────────────

model Deployment {
  id          String @id @default(cuid())
  workspaceId String

  configSnapshot String @db.Text
  version        Int

  containerId    String?
  containerImage String  @default("ghcr.io/openclaw/openclaw:latest")
  containerHost  String?

  status         DeploymentStatus @default(PENDING)
  errorMessage   String?

  startedAt      DateTime @default(now())
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
}

enum DeploymentStatus {
  PENDING
  GENERATING
  PROVISIONING
  CONFIGURING
  STARTING
  HEALTH_CHECK
  WAITING_CHANNELS
  COMPLETED
  FAILED
  ROLLED_BACK
}

// ─── ACTIVITY LOGS ──────────────────────────────────────

model ActivityLog {
  id          String @id @default(cuid())
  workspaceId String

  agentName   String?
  agentSlug   String?
  action      String
  actionType  ActivityType

  metadata    String?  @db.Text
  // PR-4: full human-expandable detail behind a short `action` summary.
  // `action` is the one-line feed text (e.g. "Heartbeat check"); `detail`
  // holds the full untruncated context (e.g. the raw heartbeat prompt with
  // the [cron:...] trace prefix, a full error stack, or a complete message
  // body). Rendered only on click-to-expand in the activity feed. Nullable —
  // most rows don't need a detail beyond their action.
  detail      String?  @db.Text

  tokenCount  Int?
  apiCost     Float?

  timestamp   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, timestamp])
  @@index([workspaceId, agentSlug])
  @@index([actionType])
}

enum ActivityType {
  HEARTBEAT
  TASK_START
  TASK_COMPLETE
  TASK_FAILED
  REVIEW_PASS
  REVIEW_REJECT
  HUMAN_REQUEST
  HUMAN_APPROVE
  HUMAN_REJECT
  MESSAGE_SENT
  MESSAGE_RECEIVED
  SKILL_INVOKED
  ERROR
  SYSTEM
  COST_ALERT
  TRADE_SIGNAL
  TRADE_RECOMMENDED
  TRADE_EXECUTED
  TRADE_CLOSED
  TRADE_BLOCKED
  CIRCUIT_BREAKER
}

// ─── WORKSPACE SNAPSHOTS ────────────────────────────────

model WorkspaceSnapshot {
  id          String @id @default(cuid())
  workspaceId String
  version     Int
  snapshot    Json
  createdAt   DateTime @default(now())
  trigger     SnapshotTrigger
  label       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, version])
  @@index([workspaceId, createdAt])
}

enum SnapshotTrigger {
  AUTO_SAVE
  MANUAL_SAVE
  PRE_DEPLOY
  TEMPLATE_LOAD
  USER_LABELED
}

// ─── AUDIT LOG ──────────────────────────────────────────

model AuditLog {
  id          String @id @default(cuid())
  userId      String?
  workspaceId String?

  action      AuditAction
  resource    String
  resourceId  String

  before      String?   @db.Text
  after       String?   @db.Text

  ipAddress   String?
  userAgent   String?

  timestamp   DateTime  @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([timestamp])
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_REGISTER
  PASSWORD_CHANGE
  API_KEY_ADDED
  API_KEY_REMOVED
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_DELETED
  AGENT_CREATED
  AGENT_UPDATED
  AGENT_DELETED
  AGENT_SOUL_UPDATED
  AGENT_SKILLS_CHANGED
  DEPLOYMENT_STARTED
  DEPLOYMENT_COMPLETED
  DEPLOYMENT_FAILED
  DEPLOYMENT_ROLLED_BACK
  CONTAINER_STARTED
  CONTAINER_STOPPED
  CONTAINER_RESTARTED
  PURCHASE_MADE
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELED
  PAYMENT_FAILED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  SKILL_VERIFIED
  USER_SUSPENDED
  TRADE_RECOMMENDED
  TRADE_APPROVED_BY_HUMAN
  TRADE_AUTO_EXECUTED
  TRADE_REJECTED_BY_HUMAN
  TRADE_LIMIT_REACHED
  TRADE_CIRCUIT_BREAKER_TRIGGERED
}

// ─── MARKETPLACE ────────────────────────────────────────

model TemplateInstall {
  id         String @id @default(cuid())
  templateId String
  userId     String

  template   ClawTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([templateId, userId])
  @@index([templateId])
  @@index([createdAt])
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.Text
  avatarUrl   String?
  websiteUrl  String?
  twitterUrl  String?
  githubUrl   String?

  isActive    Boolean  @default(true)
  agreedToTermsAt DateTime

  dodoBeneficiaryId String?

  totalInstalls  Int   @default(0)
  totalTemplates Int   @default(0)
  totalSkills    Int   @default(0)
  averageRating  Float @default(0)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates  ClawTemplate[]
  skills     MarketplaceSkill[]
  sales      MarketplaceSale[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MarketplaceSkill {
  id           String   @id @default(cuid())

  slug         String   @unique
  name         String
  description  String   @db.Text
  category     String
  tags         String[]
  emoji        String?

  skillMd      String   @db.Text
  requiredBins String[]
  requiredEnvVars String[]

  creatorId    String?
  creator      CreatorProfile? @relation(fields: [creatorId], references: [id])

  trustTier       TrustTier    @default(UNREVIEWED)
  reviewStatus    ReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  autoScanPassed   Boolean?
  autoScanReport   String?  @db.Text
  sandboxPassed    Boolean?
  sandboxReport    String?  @db.Text

  isFree       Boolean @default(true)
  price        Float?
  installCount Int     @default(0)
  isPublished  Boolean @default(false)
  publishedAt  DateTime?
  avgRating    Float?

  version            Int     @default(1)
  minOpenClawVersion String?

  reviews      SkillReview[]
  installs     SkillInstall[]
  sales        MarketplaceSale[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([trustTier])
  @@index([isPublished])
  @@index([creatorId])
  @@index([installCount])
}

model SkillReview {
  id       String @id @default(cuid())
  skillId  String
  userId   String

  rating   Int
  title    String?
  body     String?  @db.Text
  verifiedInstall Boolean @default(false)

  skill    MarketplaceSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skillId, userId])
  @@index([skillId])
}

model SkillInstall {
  id      String @id @default(cuid())
  skillId String
  userId  String

  skill   MarketplaceSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([skillId, userId])
  @@index([skillId])
  @@index([createdAt])
}

model MarketplaceSale {
  id           String   @id @default(cuid())

  templateId   String?
  skillId      String?
  template     ClawTemplate?     @relation(fields: [templateId], references: [id])
  skill        MarketplaceSkill? @relation(fields: [skillId], references: [id])

  buyerId      String
  creatorId    String
  creator      CreatorProfile @relation(fields: [creatorId], references: [id])

  amount        Float
  processingFee Float
  creatorPayout Float

  payoutStatus  PayoutStatus @default(PENDING)
  payoutHeldUntil DateTime?
  payoutBatchId String?
  paidAt        DateTime?

  dodoPaymentId String? @unique

  createdAt    DateTime @default(now())

  @@index([creatorId])
  @@index([payoutStatus])
  @@index([createdAt])
}

model Report {
  id          String @id @default(cuid())
  reporterId  String

  templateId  String?
  skillId     String?
  reviewId    String?

  reason      ReportReason
  details     String?  @db.Text

  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolution  String?

  createdAt   DateTime @default(now())

  @@index([resolved])
}

model OpenClawVersion {
  id        String   @id @default(cuid())
  version   String   @unique

  isStable  Boolean  @default(false)
  isLatest  Boolean  @default(false)
  isSecurityPatch Boolean @default(false)

  // dockerImage MUST point at an immutable :<version> reference (e.g.
  // ghcr.io/laxcorp-research/openclaw-runtime:2026.5.20), never a moving
  // pointer like :latest or :candidate. The deployer reads this field for
  // the current stable row and passes it through to Railway, so a moving
  // pointer here would make Deployment.containerImage unreliable across
  // future :latest rewrites.
  dockerImage String

  // PR-1 provenance fields (nullable; existing rows pre-date the pipeline).
  // Both written by the image pipeline's /api/internal/versions/register call.
  imageDigest    String?  // sha256:... — immutable digest of the manifest the dockerImage tag resolves to at push time
  buildSourceTag String?  // upstream git tag the image was built from (e.g. "v2026.5.20")

  releaseNotes    String? @db.Text  // free-form notes, or a URL to upstream changelog
  breakingChanges String? @db.Text

  releasedAt DateTime
  stableAt   DateTime?
  testedAt   DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── CREDIT SYSTEM ─────────────────────────────────────

enum CreditStatus {
  ACTIVE
  EXHAUSTED
  SUSPENDED
  CONVERTED
}

enum ApiKeySource {
  NONE
  PLATFORM_CREDIT
  USER_OWN_KEY
}

enum ContainerPhase {
  RUNNING
  WARM
  HIBERNATED
  WAKING
  STOPPED
}

model CreditAccount {
  id                  String       @id @default(cuid())
  userId              String       @unique

  initialGrantCents   Int          @default(2500)
  balanceCents        Int          @default(2500)
  totalConsumedCents  Int          @default(0)

  status              CreditStatus @default(ACTIVE)
  grantedAt           DateTime     @default(now())
  exhaustedAt         DateTime?

  grantFingerprint    String?
  ipAtGrant           String?
  flaggedForReview    Boolean      @default(false)

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords        CreditUsageRecord[]
  dailyUsage          CreditUsageDaily[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

model CreditUsageRecord {
  id                String      @id @default(cuid())
  creditAccountId   String
  workspaceId       String
  agentId           String?

  provider          ApiProvider
  model             String
  inputTokens       Int
  outputTokens      Int
  costCents         Int
  balanceAfterCents Int

  creditAccount     CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  createdAt         DateTime     @default(now())

  @@index([creditAccountId])
  @@index([workspaceId])
  @@index([createdAt])
}

model CreditUsageDaily {
  id                String      @id @default(cuid())
  creditAccountId   String
  workspaceId       String
  date              DateTime    @db.Date

  provider          ApiProvider
  model             String
  totalCalls        Int
  totalInputTokens  Int
  totalOutputTokens Int
  totalCostCents    Int

  creditAccount     CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@unique([creditAccountId, workspaceId, date, provider, model])
  @@index([creditAccountId])
  @@index([date])
}

// ─── CONTAINER STATE (HIBERNATION) ─────────────────────

model ContainerState {
  id                        String         @id @default(cuid())
  workspaceId               String         @unique

  containerPhase            ContainerPhase @default(STOPPED)
  lastActiveAt              DateTime?
  hibernatedAt              DateTime?
  wakeRequestedAt           DateTime?

  nextHeartbeatAt           DateTime?
  heartbeatInterval         Int?
  heartbeatCronExpressions  String?        @db.Text

  hasActiveChannels         Boolean        @default(false)
  lastChannelMessageAt      DateTime?

  activeMinutesToday        Int            @default(0)
  lastResetDate             DateTime       @default(now())

  lastWakeDurationMs        Int?
  avgWakeDurationMs         Int?

  savedVolumeId             String?
  savedContainerConfig      String?        @db.Text

  runtimeStateSnapshot      Bytes?
  runtimeStateUpdatedAt     DateTime?
  runtimeStateSizeBytes     Int?

  workspace                 Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([containerPhase])
  @@index([nextHeartbeatAt])
}
